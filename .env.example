# =============================================================================
# CodeArena — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=changeme_db_password

DATABASE_URL=jdbc:postgresql://postgres:5432/codearena
DATABASE_USERNAME=codearena
DATABASE_PASSWORD=changeme_db_password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG_FOR_HS512
JWT_EXPIRATION_MS=86400000

# ─── Judge Worker ─────────────────────────────────────────────────────────────
JUDGE_CPU_LIMIT=0.5
JUDGE_MEMORY_LIMIT_MB=256
JUDGE_TIMEOUT_SECONDS=10
JUDGE_MAX_PROCESSES=50
JUDGE_DOCKER_IMAGE=eclipse-temurin:21-jdk-alpine

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=5
RATE_LIMIT_LOGIN_ATTEMPTS=10

# ─── Seed Data (dev only) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@codearena.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_PARTICIPANT_EMAIL=student@codearena.local
SEED_PARTICIPANT_PASSWORD=Student@123
